{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,            /* Règle l'erreur ts(1259) */
    "allowSyntheticDefaultImports": true, 
    "skipLibCheck": true,               /* Accélère la compilation */
    "forceConsistentCasingInFileNames": true,
    "strict": true                      /* Qualité de code Tech Lead */
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}